# Variables del backend para Docker Compose. Configurar en .env, no versionar valores reales.
# Las variables VITE_ se leen por separado desde frontend/.env.
JWT_ISSUER_URI=
JWT_AUDIENCE=
# Compose fija JWT_REQUIRED_SCOPE=access_as_user y CORS al origen HTTPS de la SPA.

# Base de datos externa accesible desde los contenedores, con las tablas ya creadas.
# orders y catalog requieren el driver JDBC del motor elegido.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
