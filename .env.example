# Variables del backend para Docker Compose. Configurar en .env, no versionar valores reales.
# Las variables VITE_ se leen por separado desde frontend/.env.
# Workforce: JWT_ISSUER_URI=https://login.microsoftonline.com/<TENANT_ID>/v2.0
JWT_ISSUER_URI=
JWT_AUDIENCE=
# Compose fija JWT_REQUIRED_SCOPE=access_as_user y CORS a http://localhost:5173.

# Credenciales del cluster RabbitMQ. No usar guest: solo puede conectarse desde localhost del nodo.
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
# Cookie Erlang compartida por rabbitmq-1 y rabbitmq-2; sin ella los nodos no forman el cluster.
RABBITMQ_ERLANG_COOKIE=
# Compose fija RABBITMQ_ADDRESSES=rabbitmq-1:5672,rabbitmq-2:5672 y MQ_ADMIN_BASE_URL=http://mq-admin:8083.
# Al correr con Maven, RABBITMQ_ADDRESSES toma localhost:5672 por defecto.

# PostgreSQL local levantado por Compose. Opcionales: por defecto pedidos360/pedidos360/pedidos360.
DB_NAME=
DB_USERNAME=
DB_PASSWORD=
