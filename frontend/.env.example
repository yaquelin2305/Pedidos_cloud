# URL base del API. Local: BFF en http://localhost:8080. Nube: URL del API Gateway
VITE_API_BASE_URL=
# Scope de la API en el IDaaS: api://<API_CLIENT_ID>/access_as_user
VITE_API_SCOPE=
# clientId de la App Registration del frontend (Pedidos360 SPA)
VITE_AZURE_CLIENT_ID=
# Authority del tenant. Workforce: https://login.microsoftonline.com/<TENANT_ID>
VITE_AZURE_AUTHORITY=
# Host de la authority para knownAuthorities (solo External ID/CIAM). Vacio en workforce
VITE_AZURE_KNOWN_AUTHORITY=
# Redirect URI registrada en Azure
VITE_AZURE_REDIRECT_URI=
# Destino tras cerrar sesion
VITE_AZURE_POST_LOGOUT_REDIRECT_URI=
